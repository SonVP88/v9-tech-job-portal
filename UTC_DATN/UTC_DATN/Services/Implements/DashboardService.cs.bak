        // ============================================================
        // 8. Cache Management
        // ============================================================

        public async Task RefreshDashboardCacheAsync(DashboardRefreshRequestDto request)
        {
            _logger.LogInformation($"Refreshing dashboard cache for JobId: {request.JobId}");
            // Cache refresh logic
        }

        public async Task<CacheStatsDto> GetCacheStatsAsync()
        {
            var cacheEntries = await _context.AnalyticsCaches.ToListAsync();
            return new CacheStatsDto
            {
                TotalCacheEntries = cacheEntries.Count,
                ExpiredEntries = cacheEntries.Count(c => c.ExpiresAt < DateTime.UtcNow),
                CacheHitRate = cacheEntries.Any() ? Math.Round((decimal)cacheEntries.Sum(c => c.HitCount) / (cacheEntries.Sum(c => c.HitCount) + 1), 2) : 0,
                AverageCacheAge = TimeSpan.FromSeconds(cacheEntries.Any() ? cacheEntries.Average(c => (DateTime.UtcNow - c.CreatedAt).TotalSeconds) : 0)
            };
        }

        public async Task ClearCacheAsync()
        {
            var cache = await _context.AnalyticsCaches.ToListAsync();
            _context.AnalyticsCaches.RemoveRange(cache);
            await _context.SaveChangesAsync();
        }

        public async Task ClearCacheKeyAsync(string cacheKey)
        {
            var cache = await _context.AnalyticsCaches.FirstOrDefaultAsync(c => c.CacheKey == cacheKey);
            if (cache != null)
            {
                _context.AnalyticsCaches.Remove(cache);
                await _context.SaveChangesAsync();
            }
        }

