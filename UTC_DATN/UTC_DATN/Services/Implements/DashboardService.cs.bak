                    "Quality of hire is stable at 78.5%",
                    "Need to improve dropout rate"
                },
                Recommendations = new List<string>
                {
                    "Accelerate offer process to reduce dropout",
                    "Improve communication with candidates",
                    "Review interview process for consistency"
                }
            };
        }

        public async Task<LeaderboardDto> GetLeaderboardAsync(Guid jobId, int topCount = 50)
        {
            var job = await _context.Jobs.FindAsync(jobId);
            var candidates = await _context.Applications
                .Where(a => a.JobId == jobId && a.Status != "REJECTED")
                .Take(topCount)
                .ToListAsync();

            return new LeaderboardDto
            {
                JobId = jobId,
                JobTitle = job?.Title ?? "Unknown",
                TopCandidates = new List<CandidateLeaderboardDto>(),
                TotalCandidates = candidates.Count
            };
        }

