    public async Task<CandidateRankingDto> GetCandidateRankingAsync(Guid scoreId)
    {
        var score = await _context.AssessmentScores
            .Include(s => s.Candidate)
            .FirstOrDefaultAsync(s => s.ScoreId == scoreId);

        if (score == null) throw new KeyNotFoundException($"Score not found: {scoreId}");

        return new CandidateRankingDto
        {
            CandidateId = score.CandidateId,
            CandidateName = $"{score.Candidate.FirstName} {score.Candidate.LastName}",
            AssessmentId = score.AssessmentId,
            AssessmentTitle = score.Assessment.Title,
            PercentageScore = score.PercentageScore,
            IsPassed = score.IsPassed,
            Rank = score.Rank ?? 0,
            Percentile = score.Percentile ?? 0,
            CompletedAt = score.CreatedAt
        };
    }

    public async Task<AssessmentLeaderboardDto> GetLeaderboardAsync(Guid assessmentId, int topCount = 100)
    {
        var assessment = await _context.Assessments.FindAsync(assessmentId);
        if (assessment == null) throw new KeyNotFoundException($"Assessment not found: {assessmentId}");

        var rankings = await _context.AssessmentScores
            .Include(s => s.Candidate)
            .Where(s => s.AssessmentId == assessmentId)
            .OrderByDescending(s => s.PercentageScore)
            .Take(topCount)
            .Select(s => new CandidateRankingDto
            {
                CandidateId = s.CandidateId,
                CandidateName = $"{s.Candidate.FirstName} {s.Candidate.LastName}",
                AssessmentId = s.AssessmentId,
                AssessmentTitle = s.Assessment.Title,
                PercentageScore = s.PercentageScore,
                IsPassed = s.IsPassed,
                Rank = s.Rank ?? 0,
                Percentile = s.Percentile ?? 0,
                CompletedAt = s.CreatedAt
            })
            .ToListAsync();

        return new AssessmentLeaderboardDto
        {
            AssessmentId = assessmentId,
            AssessmentTitle = assessment.Title,
            Rankings = rankings,
            TotalCandidates = rankings.Count
        };
    }

    public async Task<AssessmentAnalyticsDto> GetAssessmentAnalyticsAsync(Guid assessmentId)
    {
        var assessment = await _context.Assessments
            .Include(a => a.Sections).ThenInclude(s => s.Questions)
            .FirstOrDefaultAsync(a => a.AssessmentId == assessmentId);

        if (assessment == null) throw new KeyNotFoundException($"Assessment not found: {assessmentId}");

        var scores = await _context.AssessmentScores
            .Where(s => s.AssessmentId == assessmentId)
            .ToListAsync();

        var passCount = scores.Count(s => s.IsPassed);
        var avgScore = scores.Any() ? scores.Average(s => s.PercentageScore) : 0;
        var avgTime = scores.Where(s => s.TimeSpentSeconds.HasValue).Any()
            ? scores.Where(s => s.TimeSpentSeconds.HasValue).Average(s => s.TimeSpentSeconds.Value) / 60m
            : 0;

        var difficultyDist = assessment.Sections
            .SelectMany(s => s.Questions)
            .GroupBy(q => q.DifficultyLevel)
            .ToDictionary(g => g.Key, g => g.Count());

        return new AssessmentAnalyticsDto
        {
            AssessmentId = assessmentId,
            Title = assessment.Title,
            TotalCandidatesTaken = scores.Count,
            TotalCandidatesPassed = passCount,
            PassRate = scores.Any() ? (passCount * 100m / scores.Count) : 0,
            AverageScore = avgScore,
            AverageTimeMinutes = avgTime,
            DifficultyDistribution = difficultyDist
        };
    }

    public async Task<bool> RecalculateRankingsAsync(Guid assessmentId)
    {
        var scores = await _context.AssessmentScores
            .Where(s => s.AssessmentId == assessmentId)
            .OrderByDescending(s => s.PercentageScore)
            .ToListAsync();

        var totalScores = scores.Count;

        for (int i = 0; i < scores.Count; i++)
        {
            scores[i].Rank = i + 1;
            scores[i].Percentile = (int)Math.Round((decimal)(totalScores - i) / totalScores * 100);
        }

        await _context.SaveChangesAsync();

        _logger.LogInformation($"Rankings recalculated for assessment: {assessmentId}");

        return true;
    }

    // ========================================================================
    // BULK OPERATIONS
    // ========================================================================
    public async Task<List<AssessmentSessionDto>> BulkSendAssessmentAsync(List<Guid> applicationIds, Guid assessmentId, int durationMinutes)
    {
        var assessment = await _context.Assessments.FindAsync(assessmentId);
        if (assessment == null) throw new KeyNotFoundException($"Assessment not found: {assessmentId}");

        var sessions = new List<AssessmentSessionDto>();

        foreach (var appId in applicationIds)
        {
            try
            {
                var session = await StartAssessmentSessionAsync(appId, assessmentId);
                sessions.Add(session);
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error sending assessment to application {appId}: {ex.Message}");
            }
        }

        return sessions;
    }

    public async Task<int> AutoSubmitExpiredSessionsBulkAsync(Guid assessmentId)
    {
        var expiredSessions = await _context.CandidateAssessmentSessions
            .Where(s => s.AssessmentId == assessmentId &&
                       s.SessionStatus == "IN_PROGRESS" &&
                       s.ExpiresAt < DateTime.UtcNow)
            .ToListAsync();

        int count = 0;
        foreach (var session in expiredSessions)
        {
            try
            {
                await AutoSubmitExpiredSessionAsync(session.SessionId);
                count++;
            }
            catch (Exception ex)
            {
                _logger.LogError($"Error auto-submitting session {session.SessionId}: {ex.Message}");
            }
        }

        _logger.LogInformation($"Auto-submitted {count} expired sessions for assessment {assessmentId}");

        return count;
    }

    // ========================================================================
