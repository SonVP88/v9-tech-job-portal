            QuestionText = question.QuestionText,
            QuestionOrder = question.QuestionOrder,
            PointsPerQuestion = question.PointsPerQuestion,
            IsRequired = question.IsRequired,
            DifficultyLevel = question.DifficultyLevel,
            Tags = JsonSerializer.Deserialize<List<string>>(question.Tags ?? "[]"),
            Hints = JsonSerializer.Deserialize<List<string>>(question.Hints ?? "[]"),
            AnswerExplanation = question.AnswerExplanation,
            Choices = question.Choices.Select(c => new QuestionChoiceDto
            {
                ChoiceId = c.ChoiceId,
                QuestionId = c.QuestionId,
                ChoiceOrder = c.ChoiceOrder,
                ChoiceText = c.ChoiceText
            }).ToList(),
            CreatedAt = question.CreatedAt
        };
    }

