    public async Task<List<AssessmentSessionDto>> GetAllSessionsAsync(Guid assessmentId, string statusFilter = null)
    {
        var query = _context.CandidateAssessmentSessions
            .Where(s => s.AssessmentId == assessmentId);

        if (!string.IsNullOrEmpty(statusFilter))
        {
            query = query.Where(s => s.SessionStatus == statusFilter);
        }

        var sessions = await query.ToListAsync();

        return sessions.Select(s => new AssessmentSessionDto
        {
            SessionId = s.SessionId,
            ApplicationId = s.ApplicationId,
            AssessmentId = s.AssessmentId,
            CandidateId = s.CandidateId,
            SessionStatus = s.SessionStatus,
            StartedAt = s.StartedAt,
            SubmittedAt = s.SubmittedAt,
            ExpiresAt = s.ExpiresAt,
            DurationMinutes = s.DurationMinutes,
            ResumCount = s.ResumCount
        }).ToList();
    }

    public async Task<bool> DeleteAllSessionsAsync(Guid assessmentId)
    {
        var sessions = await _context.CandidateAssessmentSessions
            .Where(s => s.AssessmentId == assessmentId)
            .ToListAsync();

        _context.CandidateAssessmentSessions.RemoveRange(sessions);
        await _context.SaveChangesAsync();

        _logger.LogWarning($"All sessions deleted for assessment: {assessmentId}");

        return true;
    }

