    private async Task<AssessmentDto> GetAssessmentDtoAsync(Assessment assessment)
    {
        var sections = await _context.AssessmentSections
            .Include(s => s.Questions)
            .Where(s => s.AssessmentId == assessment.AssessmentId)
            .ToListAsync();

        return new AssessmentDto
        {
            AssessmentId = assessment.AssessmentId,
            AssessmentTypeId = assessment.AssessmentTypeId,
            TypeCode = assessment.AssessmentType?.TypeCode ?? "",
            Title = assessment.Title,
            Description = assessment.Description,
            DurationMinutes = assessment.DurationMinutes,
            PassingScore = assessment.PassingScore,
            IsRandomizeQuestions = assessment.IsRandomizeQuestions,
            ShowResultsToCandidate = assessment.ShowResultsToCandidate,
            RequiredForJob = assessment.RequiredForJob,
            IsActive = assessment.IsActive,
            TotalQuestions = sections.SelectMany(s => s.Questions).Count(),
            TotalPoints = sections.SelectMany(s => s.Questions).Sum(q => q.PointsPerQuestion),
            CreatedAt = assessment.CreatedAt,
            Sections = sections.Select(s => new AssessmentSectionDto
            {
                SectionId = s.SectionId,
                AssessmentId = s.AssessmentId,
                SectionTitle = s.SectionTitle,
                SectionDescription = s.SectionDescription,
                SectionOrder = s.SectionOrder,
                DurationMinutes = s.DurationMinutes,
                QuestionCount = s.Questions.Count,
                TotalPoints = s.Questions.Sum(q => q.PointsPerQuestion)
            }).ToList()
        };
    }

