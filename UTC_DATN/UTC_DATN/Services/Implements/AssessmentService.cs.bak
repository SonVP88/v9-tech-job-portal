    public async Task<List<CandidateAssessmentStatusDto>> GetCandidateAssessmentStatusAsync(Guid candidateId)
    {
        var result = await GetCandidatePendingAssessmentsAsync(candidateId);
        return result.PendingAssessments.Concat(result.CompletedAssessments).ToList();
