    public async Task<(bool CanStart, string Reason)> CanStartAssessmentAsync(Guid applicationId, Guid assessmentId)
    {
        var application = await _context.Applications.FindAsync(applicationId);
        if (application == null) return (false, "Application not found");

        var assessment = await _context.Assessments.FindAsync(assessmentId);
        if (assessment == null) return (false, "Assessment not found");

        var existingSession = await _context.CandidateAssessmentSessions
            .FirstOrDefaultAsync(s => s.ApplicationId == applicationId &&
                                       s.AssessmentId == assessmentId &&
                                       (s.SessionStatus == "SUBMITTED" || s.SessionStatus == "COMPLETED"));

        if (existingSession != null) return (false, "Assessment already completed");

        return (true, "");
    }

