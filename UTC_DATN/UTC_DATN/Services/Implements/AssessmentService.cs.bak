            ApplicationId = score.ApplicationId,
            AssessmentId = score.AssessmentId,
            TotalPoints = score.TotalPoints,
            MaxPoints = score.MaxPoints,
            PercentageScore = score.PercentageScore,
            PassingScore = score.PassingScore,
            IsPassed = score.IsPassed,
            CorrectAnswersCount = score.CorrectAnswersCount,
            TotalQuestionsCount = score.TotalQuestionsCount,
            TimeSpentSeconds = score.TimeSpentSeconds,
            Rank = score.Rank,
            Percentile = score.Percentile,
            EvaluatedAt = score.EvaluatedAt,
            CreatedAt = score.CreatedAt
        };
    }
